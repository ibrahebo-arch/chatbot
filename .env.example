# ملف الأسرار – انسخه إلى .env (الملف .env مخفي ولا يُرفع إلى GitHub أبداً)
# Copy to .env – .env is gitignored and never pushed. Never put real values in this example.

# مفتاح OpenAI (ChatGPT) لمساعد الدردشة وملف الإنتاج
OPENAI_API_KEY=sk-proj-ضع-مفتاحك-هنا
OPENAI_MODEL=gpt-4o-mini

# Postgres – محلياً: قاعدة بيانات على جهازك، مثل postgresql://postgres:postgres@localhost:5432/vi_iraq
# على Render يُحقن تلقائياً من قاعدة vi-iraq-db (لا تنسخه يدوياً)
DATABASE_URL=

# Cloudflare R2 (تخزين المرفقات والفيديوهات) – الدلو خاص (private)
# محلياً يمكن تركها فارغة: تُحفظ الملفات مؤقتاً في مجلد temp للتجربة فقط
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# مرحلة التجربة المجانية: true = الحالات تتقدم كل ثانية ويصل الزبون فيديو عشوائي من public/loops
# اجعلها false عند تفعيل الدفع (يعود مسار موافقة المشرف /confirm)
DEMO_DELIVERY=true

# الانتظار بين طلبين لنفس الزبون (بالدقائق) – لا ينطبق إذا استلم الفيديو
ORDER_COOLDOWN_MINUTES=20

# البريد – Brevo أو Resend: بريد 1 عند وصول طلب جديد، بريد 2 عند تسليم الفيديو
MAIL_PROVIDER=
BREVO_API_KEY=xkeysib-ضع-مفتاحك-هنا
RESEND_API_KEY=
MAIL_FROM=ibrahebo@gmail.com
MAIL_FROM_NAME=VI Iraq
MAIL_TO=ibrahim2dms@gmail.com
MAIL_ATTACH_MB=10

# false = كل طلب ينتظر موافقة المشرف (/confirm) قبل صرف أي رصيد
AUTO_GENERATE=false

# للخطوة القادمة (التوليد التلقائي) – غير مستخدمة بعد
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
HIGGSFIELD_API_KEY=

PORT=3000

# كلمة مرور المشرف: /admin في البوت و x-admin-token في /api/requests
ADMIN_TOKEN=change-me

# رابط الموقع العام (يُستخدم لـ Webhook تيليغرام)
PUBLIC_URL=http://localhost:3000

# الحد الأقصى لحجم الفيديو المرفق في الدردشة (الصور حدها 20 MB)
ATTACH_LIMIT=200mb

# بوت تيليغرام للتسليم – التوكن من BotFather
TELEGRAM_BOT_TOKEN=
# معرّفات محادثات المشرفين (اختياري – أو أرسل /admin ADMIN_TOKEN للبوت)
TELEGRAM_ADMIN_CHAT_IDS=
# للتطوير المحلي فقط: 1 = استقبال رسائل البوت محلياً (لا تفعّله مع نسخة منشورة بنفس التوكن)
TELEGRAM_POLL=
