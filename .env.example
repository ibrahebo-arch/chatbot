# ملف الأسرار – انسخه إلى .env (الملف .env مخفي ولا يُرفع إلى GitHub أبداً)
# Copy to .env – .env is gitignored and never pushed. Never put real values in this example.

# مفتاح OpenAI (ChatGPT) لمساعد الدردشة وملف الإنتاج
OPENAI_API_KEY=sk-proj-ضع-مفتاحك-هنا
OPENAI_MODEL=gpt-4o-mini

# Postgres – محلياً: قاعدة بيانات على جهازك، مثل postgresql://postgres:postgres@localhost:5432/vi_iraq
# على Render يُحقن تلقائياً من قاعدة vi-iraq-db (لا تنسخه يدوياً)
DATABASE_URL=

# Cloudflare R2 (تخزين المرفقات والفيديوهات) – الدلو خاص (private)
# محلياً يمكن تركها فارغة: تُحفظ الملفات مؤقتاً في مجلد temp للتجربة فقط
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# مرحلة التجربة المجانية: true = الحالات تتقدم كل ثانية ويصل الزبون فيديو عشوائي من public/loops
# اجعلها false عند تفعيل الدفع (يعود مسار موافقة المشرف /confirm)
DEMO_DELIVERY=true

# الانتظار بين طلبين لنفس الزبون (بالدقائق) – لا ينطبق إذا استلم الفيديو
ORDER_COOLDOWN_MINUTES=20

# البريد – Brevo أو Resend: بريد 1 عند وصول طلب جديد، بريد 2 عند تسليم الفيديو
MAIL_PROVIDER=
BREVO_API_KEY=xkeysib-ضع-مفتاحك-هنا
RESEND_API_KEY=
MAIL_FROM=ibrahebo@gmail.com
MAIL_FROM_NAME=VI Iraq
MAIL_TO=ibrahim2dms@gmail.com
MAIL_ATTACH_MB=10

# false = كل طلب ينتظر موافقة المشرف (/confirm) قبل صرف أي رصيد
AUTO_GENERATE=false

# الدفع عبر Wayl (thewayl.com) – بدون WAYL_API_KEY يبقى الدفع معطلاً ويعود مسار تأكيد تيليغرام
# Payments through Wayl. Empty WAYL_API_KEY = payments off.
# مفتاح إنشاء روابط الدفع / creates payment links
WAYL_API_KEY=
# مفتاح التحقق من الدفع / reads links back to confirm payment (defaults to WAYL_API_KEY)
WAYL_VERIFY_KEY=
# test = روابط اختبار · live = دفع حقيقي
WAYL_ENV=test
# سعر الصرف لتحويل السعر من الدولار إلى الدينار (يُقرّب لأعلى إلى 250)
PAY_IQD_PER_USD=1310
# مدة صلاحية رابط الدفع (30m, 1h, 24h, 7d)
WAYL_LINK_EXPIRES=24h
# عنوان الموقع المسجّل في متجر Wayl (للـ webhook والرجوع بعد الدفع) – افتراضياً PUBLIC_URL
PAY_PUBLIC_URL=

# التجربة المجانية (بدون تسجيل ولا دفع) عبر fal.ai – بدون FAL_KEY تبقى معطلة
# Free trial through fal.ai. Empty FAL_KEY = trial off.
FAL_KEY=
# لكل IP خلال TRIAL_WINDOW_DAYS يوماً / per visitor IP
TRIAL_IMAGES=3
TRIAL_VIDEOS=1
TRIAL_WINDOW_DAYS=30
TRIAL_VIDEO_SECONDS=5
# سقف الصرف اليومي بالدولار – بعده تتوقف التجربة حتى الغد / daily spend cap (USD)
TRIAL_DAILY_BUDGET_USD=5
# الموديلات (اختياري) / models (optional)
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=minimax/h3-max-turbo/text-to-video
FAL_I2V_MODEL=minimax/h3-max-turbo/image-to-video
# ChatGPT يكتب وصف الصورة/الفيديو من محادثة الزبون / ChatGPT writes the prompt from the chat
PROMPT_MODEL=gpt-6-sol
# صور ChatGPT: للأساليب المذكورة، وتلقائياً لكل الصور إذا نفد رصيد fal / ChatGPT pictures
OPENAI_IMAGE_MODEL=chatgpt-image-latest
OPENAI_IMAGE_QUALITY=medium
TRIAL_OPENAI_STYLES=cartoon
OPENAI_IMAGE_COST_USD=0.04

# للخطوة القادمة (التوليد التلقائي) – غير مستخدمة بعد
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
HIGGSFIELD_API_KEY=

PORT=

# بدون R2: مجلد حفظ مرفقات الزبائن – على السيرفر اجعله مساراً دائماً (المجلد المؤقت يُمسح عند إعادة التشغيل)
# Without R2: folder for customer uploads – on a VPS use a permanent path (the temp folder is wiped on reboot)
STORAGE_DIR=
# اتركه فارغاً: عنوان الزائر يؤخذ من Cloudflare (CF-Connecting-IP) أو من nginx المحلي فقط
# Leave empty: visitor IP comes from Cloudflare's CF-Connecting-IP, or the local nginx only
TRUST_PROXY=3000

# كلمة مرور المشرف: /admin في البوت و x-admin-token في /api/requests
ADMIN_TOKEN=change-me

# رابط الموقع العام (يُستخدم لـ Webhook تيليغرام)
PUBLIC_URL=http://localhost:3000

# الحد الأقصى لحجم الفيديو المرفق في الدردشة (الصور حدها 20 MB)
ATTACH_LIMIT=200mb

# بوت تيليغرام للتسليم – التوكن من BotFather
TELEGRAM_BOT_TOKEN=
# معرّفات محادثات المشرفين (اختياري – أو أرسل /admin ADMIN_TOKEN للبوت)
TELEGRAM_ADMIN_CHAT_IDS=
# للتطوير المحلي فقط: 1 = استقبال رسائل البوت محلياً (لا تفعّله مع نسخة منشورة بنفس التوكن)
TELEGRAM_POLL=
