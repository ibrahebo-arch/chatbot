# ملف الأسرار – انسخه إلى .env (الملف .env مخفي ولا يُرفع إلى GitHub أبداً)
# Copy to .env – .env is gitignored and never pushed.

# مفتاح OpenAI (ChatGPT) – أضف مفتاحك هنا فقط، ولا تضعه في أي ملف آخر
OPENAI_API_KEY=sk-proj-ضع-مفتاحك-هنا
OPENAI_MODEL=gpt-4o-mini

# البريد – عبر Brevo أو Resend (لا يحتاج Gmail ولا التحقق بخطوتين)
# اختر واحداً فقط وضع مفتاحه. يُختار المزوّد تلقائياً حسب المفتاح الموجود.
#   Brevo:  brevo.com → SMTP & API → API keys  (المفتاح يبدأ بـ xkeysib-)
#           ثم أضف المرسل MAIL_FROM وفعّله من: Senders, Domains & Dedicated IPs → Senders
#   Resend: resend.com → API Keys  (المفتاح يبدأ بـ re_)
#           بدون دومين: MAIL_FROM=onboarding@resend.dev ويصل البريد فقط إلى بريد حساب Resend نفسه
MAIL_PROVIDER=
BREVO_API_KEY=xkeysib-ضع-مفتاحك-هنا
RESEND_API_KEY=
MAIL_FROM=ibrahebo@gmail.com
MAIL_FROM_NAME=VI Iraq
# الحجم الأقصى للملفات المرفقة بالبريد (MB)؛ الأكبر تُرسل كروابط
MAIL_ATTACH_MB=10

# البريد الذي تصل إليه الطلبات
MAIL_TO=ibrahim2dms@gmail.com

PORT=3000

# كلمة مرور رفع/حذف فيديوهات الخلفية من داخل الموقع (اختياري)
ADMIN_TOKEN=change-me

# رابط الموقع العام (يُستخدم لروابط المرفقات الكبيرة داخل البريد)
PUBLIC_URL=http://localhost:3000

# الحد الأقصى لحجم المرفق في الدردشة (صور/فيديو)
ATTACH_LIMIT=200mb
